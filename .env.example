# QR-Relay 基础设置
HOST=0.0.0.0
PORT=8080
# 你的服务器公网访问地址或域名（用于生成二维码中的分享链接）
BASE_URL=http://localhost:8080
# 单个文件最大大小 (MB)
MAX_FILE_SIZE_MB=100
# 中转站总存储配额限制 (GB)
MAX_TOTAL_STORAGE_GB=10
# 上传密码（留空则任何人均可上传，若设置则上传需要密码，提取查看始终无需密码）
UPLOAD_PASSWORD=
# 本地过期文件自动清理周期（秒）
AUTO_CLEANUP_INTERVAL_SECONDS=60

# OpenList (WebDAV) 备份对接设置
# 提示: 如果与 OpenList 在同一台机器或同一 Docker 网络中，可填写 http://openlist:5244/dav
OPENLIST_WEBDAV_URL=http://localhost:5244/dav
OPENLIST_USERNAME=admin
OPENLIST_PASSWORD=your_openlist_password
# 在 OpenList 网盘中的归档备份目录
OPENLIST_BACKUP_PATH=/QR-Relay-Backup
OPENLIST_AUTO_SYNC=True
